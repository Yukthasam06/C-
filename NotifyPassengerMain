	private boolean validateCheckIn(Reservations.Reservation rsvr) {
		LOGGER.info(" VALIDATING BOOKING --> " + rsvr.getLocator());
		boolean isWheelChair = false;
		boolean isMinorPanssgr = false;
		boolean isExceedspassengerLimit = false;

		for (PassengerPNRB passengerLst : rsvr.getGetReservationRS()
				.getReservation().getPassengerReservation().getPassengers()
				.getPassenger()) {
			if (passengerLst.getSpecialRequests() != null) {
				if (passengerLst.getSpecialRequests().getWheelchairRequest() != null
						&& !passengerLst.getSpecialRequests().getWheelchairRequest().isEmpty()) {
					isWheelChair = true;
					++wheelChairPassengerCount;
					LOGGER.info( " SPECIAL WHEEL CHAIR REQUEST EXIST FOR BOOKING --> " + rsvr.getLocator());
				}
				if (passengerLst.getSpecialRequests().getUnaccompaniedMinorMessage() != null
						&& !passengerLst.getSpecialRequests().getUnaccompaniedMinorMessage().isEmpty()) {
					isMinorPanssgr = true;
					++minorPassengerCount;
					LOGGER.info(" MINOR PASSENGER EXIST FOR BOOKING --> "+ rsvr.getLocator());
				}
			}
		}

		if (rsvr.getGetReservationRS().getReservation().getNumberInParty() > 9) {
			isExceedspassengerLimit = true;
			++passengerExceedLimitCount;
			LOGGER.info(" PASSENGER LIMIT EXCEED FOR BOOKING --> "
					+ rsvr.getLocator());
		}

		if (isWheelChair || isMinorPanssgr || isExceedspassengerLimit)
			return false;
		else
			return true;
	}

	private volatile static int SPLIT_RANGE = 14;
	
	/**
	 * 
	 * @param departDate
	 * @param flightNumber
	 * @param originStation
	 * @param passengerList
	 * @param checkInStatusMap
	 */
	public void findCheckinStatus(String departDate, String flightNumber,
			String originStation, List<PassengerACS> passengerList,
			Map<String, String> checkInStatusMap) {
		List<List<PassengerACS>> passengerNList = null;
		try {
			LOGGER.info("CHECKED-IN PASSENGERS REQUEST AND RESPONSE :: PASSENGER SIZE - "+passengerList.size());

			if (null != passengerList && !passengerList.isEmpty()) {
				
				passengerNList = new ArrayList<List<PassengerACS>>(); 
				
				int startindex = 0;
				int remRange = passengerList.size() % SPLIT_RANGE;
				int ques = passengerList.size() / SPLIT_RANGE;
				int remRange1 = SPLIT_RANGE * ques;
				
				for (int i = 0; i < ques; i++) {
					if (i == 0) {
						passengerNList.add(passengerList.subList(startindex, Math.min(passengerList.size(), 15)));
						startindex = i;
					} else {
						int range = SPLIT_RANGE * i;
						passengerNList.add(passengerList.subList(range, range + SPLIT_RANGE));
					}
				}
				
				if (remRange > 0) {
					passengerNList.add(passengerList.subList(remRange1, remRange1 + remRange));
 				}  
				 
				// The below code is to retreive the remainder elements to array 
				LOGGER.info("TOTAL SUB LIST SIZE IS :: "+passengerNList.size());

				for (List<PassengerACS> passList : passengerNList) {

					GetPassengerDataRSACS rs = sabreService.getPassengerData(token, departDate, flightNumber, originStation,passList);

					if (null != rs && null != rs.getPassengerDataResponseList()
							&& !rs.getPassengerDataResponseList().getPassengerDataResponse().isEmpty()) {
						List<PassengerDataResponseACS> dataResponseACSs = rs.getPassengerDataResponseList().getPassengerDataResponse();
						for (PassengerDataResponseACS dataResponseACS : dataResponseACSs) {
							if (null != dataResponseACS
									.getPassengerItineraryList()
									&& null != dataResponseACS.getPassengerItineraryList().getPassengerItinerary()
									&& !dataResponseACS.getPassengerItineraryList().getPassengerItinerary().isEmpty()) {
								// Consider first passenger as always one
								// passenger
								// data
								// returned
								PassengerItineraryACS passengerItineraryACS = dataResponseACS.getPassengerItineraryList().getPassengerItinerary().get(0);
								if (null != passengerItineraryACS
										.getBoardingPassFlag()
										&& passengerItineraryACS.getBoardingPassFlag().equalsIgnoreCase("*"))
									checkInStatusMap.put(dataResponseACS.getPNRLocator().getValue(),passengerItineraryACS.getBoardingPassFlag());
							}
						}
					}
				}
			}
		} catch (Exception e) {
			LOGGER.error("Excpetion while finding check-in status :", e);
		}
	}

