 	private List<String> mapSpecialMealData(final List<PassengerPNRB> passList, 
 			int flightNumber,final String date,final String dept,final String arr) { 		
  		List<String> mealData = new LinkedList<String>();
  		for (Iterator<PassengerPNRB> passPnrb = passList.iterator(); passPnrb.hasNext();)  {
			PassengerPNRB passPnb = passPnrb.next();	
			boolean flag = true; 
			if(null != passPnb.getSpecialRequests()
					&& null != passPnb.getSpecialRequests().getSpecialMealRequest()) {
				for (SpecialMealRequestPNRB spmPnrb : passPnb.getSpecialRequests()
						.getSpecialMealRequest()) {				
					if(spmPnrb.getType().name().contains("G"))   
						if (spmPnrb.getBoardCity().contains(dept)
								&& date.contains(spmPnrb.getFlightDate())
								&& spmPnrb.getOffCity().contains(arr)
								&& flightNumber == Integer.parseInt(spmPnrb.getFlightNumber().replaceAll("\\s", ""))) { 
								flag = false;
								mealData.add(new StringBuilder(spmPnrb.getId())
											.append("_").append(spmPnrb.getMealType())
											.append("_").append(passPnb.getFirstName())
											.append("_").append(passPnb.getLastName()).toString());
		 				}
					
				}
				
				if(flag)
				for (SpecialMealRequestPNRB spmPnrb : passPnb.getSpecialRequests()
						.getSpecialMealRequest()) {				
					if(spmPnrb.getType().name().contains("A"))  
						if (spmPnrb.getBoardCity().contains(dept)
								&& date.contains(spmPnrb.getFlightDate())
 								&& flightNumber == Integer.parseInt(spmPnrb.getFlightNumber().replaceAll("\\s", ""))) {
							mealData.add(new StringBuilder(spmPnrb.getId())
									.append("_").append(spmPnrb.getMealType())
									.append("_").append(passPnb.getFirstName())
									.append("_").append(passPnb.getLastName()).toString());
		 				}
					
				}				
			}
 		}
		return mealData;
	}
  
 	
 	
	private static String[] dynamicStringArray(String[] oldData) {
		if (oldData.length == (INDEX + 1)) {
			String[] newArray = new String[oldData.length + 1];
			for (int ind = 0; ind < oldData.length; ind++) {
				newArray[ind] = oldData[ind];
			}
			return newArray;
		} else
			return oldData;
  	}
	
	private static String[] constructMealData(String[] mealData,
				final SpecialMealRequestPNRB spmPnrb,
				final PassengerPNRB passPnb) {
		String temp[] = dynamicStringArray(mealData);
 		temp[INDEX++] =  new StringBuilder(spmPnrb.getId())
				.append("_").append(spmPnrb.getMealType())
				.append("_").append(passPnb.getFirstName())
				.append("_").append(passPnb.getLastName()).toString();
		return temp; 
 		
 	}

