	private static String getFullName(String firstName, String lastName) {
		StringBuilder nameWithSalutation = new StringBuilder(10);
		if (null != firstName && null != lastName) {
			String title = "";
			if (firstName.toUpperCase().lastIndexOf("MRS") != -1) {
				title = "MRS";
			} else if (firstName.toUpperCase().lastIndexOf("MR") != -1) {
				title = "MR";
			} else if (firstName.toUpperCase().lastIndexOf("MS") != -1) {
				title = "MS";
			} else if (firstName.toUpperCase().lastIndexOf("DR") != -1) {
				title = "DR";
			}
			nameWithSalutation.append(title).append(".").append(" ")
					.append(firstName.substring(0,
							firstName.lastIndexOf(title)))
					.append(" ").append(lastName);
		}

		return nameWithSalutation.toString().startsWith(". ")
				? nameWithSalutation.toString().replace(". ", "")
				: nameWithSalutation.toString();
	}
