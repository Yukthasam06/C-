	public void startProcess() {
		LOGGER.info("<----- PROCESS HAS STARTED ----->");
		Map<String, String> sabreSession = null;
		try {
			sabreSession = sabreService.sessionCreate();
			String sabreSessionStatus = sabreSession.get("status").trim();
			LOGGER.info("sabreSessionStatus============> " + sabreSessionStatus);
			if (sabreSessionStatus.equalsIgnoreCase("Approved")) {
				token = sabreSession.get("securityToken");
				notifyPassenger(token);
			}else {
				LOGGER.info("################# ERROR IN SABRE WEB SERVICE SESSION CREATION ##################");
				emailErrorMessageList.add(" ERROR IN SABRE WEB SERVICE SESSION CREATION - SESSION STATUS 'NOT APPROVED' ");
			}
		} catch (Exception e) {
			LOGGER.error("####### EXCEPTION IN PROCESSING ####### "+ e.getMessage(),e);
			emailErrorMessageList.add(" EXCEPTION IN SABRE WEB SERVICE SESSION CREATION ORIGINAL EXCEPTION --> " + e.getMessage());
		}
	}

