<script type="text/javascript" >

function submitAccept() {
	
	if(!addAcceptedList()) {
		return 0;
	}
	var actionString = '<%=request.getContextPath()%>/StsSearchAction.do?op=reqlst';
	document.forms[0].action = actionString;
	document.forms[0].submit();
}

function addAcceptedList() {
	var cnt = 0;
	document.forms[0].acceptedListStr.value = '';
	document.forms[0].ticketIdListStr.value = '';

	if(document.forms[0].chkAccpt.length == null) {
		if (document.forms[0].chkAccpt.checked) {
			cnt++;
			document.forms[0].acceptedListStr.value = document.forms[0].acceptedListStr.value + ',' 
						 + document.forms[0].requestId.value;
		    document.forms[0].ticketIdListStr.value = document.forms[0].ticketIdListStr.value + ',' 
						 + document.forms[0].ticketId.value;
		}
	} else {
		for (i=0;i<document.forms[0].chkAccpt.length;i++) {
			if (document.forms[0].chkAccpt[i].checked) {
				cnt++;
				document.forms[0].acceptedListStr.value = document.forms[0].acceptedListStr.value + ',' 
							 + document.forms[0].requestId[i].value;
		        document.forms[0].ticketIdListStr.value = document.forms[0].ticketIdListStr.value + ',' 
							 + document.forms[0].ticketId[i].value;							 
			}
		}
	}
	if(cnt > 0) {
		 return true;
	} else {
		alert('No requests selected to accept');
		return false;	 
	}
}

function checkAllBox(chkall) {
	if(document.forms[0].chkAccpt.length == null) {
			if(chkall.checked)
				document.forms[0].chkAccpt.checked = true;
			else 
				document.forms[0].chkAccpt.checked = false;
	
	} else {
		for (i=0;i<document.forms[0].chkAccpt.length;i++) {
			if(chkall.checked)
				document.forms[0].chkAccpt[i].checked = true;
			else 
				document.forms[0].chkAccpt[i].checked = false;
		}
	}
}
</script>
