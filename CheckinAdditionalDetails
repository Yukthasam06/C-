					</div>

					<div class="twoCol feedSearch clearfix">
						<div class="col" style="width: 90%">
							<rich:column>
								<b><h:outputLabel value="Investigation Feedback"
										style="padding-left: 15px;" /></b>
								<div style="overflow: auto; max-height: 200px;"
									class="form-box form-box-default">
									<h:outputText
										value="#{feedbackAssignToAccbleMgrController.supFeedbackDetailsDTO.accbleReport}"
										styleClass="formControl" escape="false" />
								</div>
							</rich:column>
						</div>
					</div>

				</div>
			</h:panelGrid>

			<div class="panel">
				<div class="panelHeader"
					style="text-align: left; padding-left: 15px">
					<h2>
						<b>Assigned Task Details</b>
					</h2>
				</div>

				<div class="tableWrapper accountable-list" id="accountableList"
					style="text-align: left; padding: 10px">

					<div class="twoCol feedSearch clearfix">
						<div class="col" style="width: 100%">
							<div class="form-box form-box-default">
								<label>Description</label>
								<h:inputTextarea
									value="#{feedbackAssignToAccbleMgrController.updateDTO.taskDesc}"
									styleClass="formControl editor" />

							</div>
						</div>
					</div>

					<div class="twoCol feedSearch clearfix">
						<div class="col" style="width: 90%">
							<div class="form-box form-box-default" style="width: 520px">

								<rich:panel id="fileUploadPanel">
									<h:outputLabel value="Attach Related Documents" />
									<rich:fileUpload id="fileUpload"
										fileUploadListener="#{feedbackAssignToAccbleMgrController.fileUploadAssist}"
										maxFilesQuantity="5" style="border: none;"
										render="fileUploadPanel"
										acceptedTypes="doc, docx, txt, rtf, pdf, xls, xlsx, zip, jpg, jpeg, jpe, gif, png, bmp, rar, eml, msg, html, htm"
										sizeExceededLabel="Please Upload a file less than 102MB in size"
										ontyperejected="alert('Only JPG, JPE, JPEG, GIF, PNG, PDF, BMP, DOC, DOCX, TXT, RTF, XLS, XLSX, ZIP, RAR, EML, MSG and HTML files are accepted');"
										listHeight="1px" immediateUpload="true">
										<f:attribute name="attachmentValue" value="4" />
									</rich:fileUpload>
									<br />
									<div>
										<h:dataTable var="attachmentLocal"
											columnClasses="width30, width5"
											value="#{feedbackAssignToAccbleMgrController.uploadAttachmentMap.get('4')}"
											id="attachmentTable">
											<h:column>
												<h:outputLabel value="#{attachmentLocal.actualFileName}" />
											</h:column>
											<h:column>
												<a4j:commandButton
													style="width: 80px; background-color: #ec6f5a;color:white;font-size:12px"
													actionListener="#{feedbackAssignToAccbleMgrController.deleteAttachmentAssit}"
													id="#{panel}deleteAttachment" value="Delete"
													render="fileUploadPanel" execute="@this" title="Delete">
													<f:param name="filePathDelete"
														value="#{attachmentLocal.systemFileName}" />
													<f:param name="attachmentValue" value="4" />
												</a4j:commandButton>
											</h:column>
										</h:dataTable>

									</div>
									<br />
									<div align="center">
										<a4j:commandLink
											action="#{feedbackAssignToAccbleMgrController.clearUploadData}"
											execute="@this" render="fileUploadPanel" value="Clear All"
											styleClass="btn btn-primary red"
											rendered="#{not empty feedbackAssignToAccbleMgrController.uploadAttachmentMap.get('4')}">
											<f:param name="attachmentValue" value="4" />
										</a4j:commandLink>
									</div>
									<br />
									<div class="smallTxt">You can upload doc, docx, txt, rtf,
										pdf, xls, xlsx, zip, jpg, jpeg, jpe, gif, png, bmp, rar, eml,
										msg, html or htm files. (Maximum total size of 12MB)</div>
								</rich:panel>
							</div>
						</div>

					</div>

					<div class="twoCol feedSearch clearfix">
						<div class="col" style="width: 90%">
							<div
								class="form-box form-box-default form-group form-group-default input-group">
								<c:if
									test="#{not empty feedbackAssignToAccbleMgrController.updateDTO.attachedInternalDocs}">
									<label>Uploaded Attachments</label>
									<h:dataTable
										value="#{feedbackAssignToAccbleMgrController.updateDTO.attachedInternalDocs}"
										var="attachment" style="margin:10px">
										<h:column>
											<h:commandLink
												action="#{feedbackDetailsOpenController.downloadAttachment(attachment)}">
												<i class="fa fa-file-text-o"></i>  #{attachment.actualFileName}
										    </h:commandLink>
										</h:column>
									</h:dataTable>
								</c:if>
							</div>
						</div>
					</div>

					<div class="twoCol feedSearch clearfix">
						<div class="col" style="width: 90%">
							<div
								class="form-box form-box-default form-group form-group-default input-group">
								<label>Target Date</label>
								<h:inputText id="taskTargetDate"
									value="#{feedbackAssignToAccbleMgrController.updateDTO.taskTargetDate}"
									styleClass="formControl dtpciker"
									style="border:none;padding:10px" onfocus="setDatepicker();">
									<rich:placeholder value="(Click here to select date)"></rich:placeholder>
								</h:inputText>

							</div>
						</div>
					</div>

					<c:if
						test="#{feedbackAssignToAccbleMgrController.updateDTO.valid ne 'N'}">
						<div class="twoCol feedSearch clearfix">
							<div class="col">
								<div
									class="form-box form-box-default form-group form-group-default input-group">
									<label>Status</label>
									<h:selectOneMenu
										value="#{feedbackAssignToAccbleMgrController.updateDTO.taskStatusId}"
										styleClass="formControl" style="border:none">
										<f:selectItem itemLabel="Open" itemValue="10" />
										<f:selectItem itemLabel="In Progress" itemValue="20" />
										<f:selectItem itemLabel="Closed" itemValue="30" />
									</h:selectOneMenu>

								</div>
							</div>
						</div>
					</c:if>

					<div class="btnGroup" style="padding: 10px">

						<h:commandButton value="Update" styleClass="btn btn-primary">
							<f:attribute name="dto"
								value="#{feedbackAssignToAccbleMgrController.updateDTO}"></f:attribute>
							<f:attribute name="feedbackID"
								value="#{feedbackDetailsOpenController.myTaskDto.feedbackId}"></f:attribute>
							<f:attribute name="feedbackStatusID"
								value="#{feedbackDetailsOpenController.myTaskDto.feedbackStatusID}"></f:attribute>
							<f:ajax event="click" execute="@form"
								listener="#{feedbackAssignToAccbleMgrController.updateSelectedAccountable}"></f:ajax>
						</h:commandButton>

					</div>
				</div>

			</div>
		</rich:popupPanel>
	</h:form>

	<h:form>
		<rich:popupPanel id="popupAdditionalDate" modal="true"
			resizeable="true" minHeight="400" minWidth="800"
			style="background-color:#F5F6EB;text-align:left"
			domElementAttachment="form">

			<f:facet name="controls">
				<h:outputLink value="#"
					onclick="#{rich:component('popupAdditionalDate')}.hide(); return false;">
					<b>[X]</b>
				</h:outputLink>
			</f:facet>

			<f:facet name="header">
				<div class="panelHeader" style="text-align: left">
					<h2>
						<b>Additional Target Date Details</b>
					</h2>
				</div>
			</f:facet>

			<div class="twoCol feedSearch clearfix">
				<div class="col" style="width: 90%">
					<div>
						<label><b>New Target Date: </b></label>
						<h:outputText
							value="#{additionalTargetDateController.additionalTrgDateReqDTO.strReqTargetDate}"
							style="border:none;padding:10px" />

					</div>
				</div>
			</div>
			<div class="twoCol feedSearch clearfix">
				<div class="col" style="width: 90%; margin-top: 15px">
					<div>
						<label><b>Comments:</b></label>
						<h:inputTextarea
							value="#{additionalTargetDateController.additionalTrgDateReqDTO.comments}"
							styleClass="formControl editorNew1" />

					</div>
				</div>
			</div>

			<div class="btnGroup" style="padding: 10px">

				<h:commandButton value="Approve" styleClass="btn btn-primary">
					<f:attribute name="feedbackID"
						value="#{feedbackDetailsOpenController.myTaskDto.feedbackId}"></f:attribute>
					<f:attribute name="addTrgDateReqDTO"
						value="#{additionalTargetDateController.additionalTrgDateReqDTO}"></f:attribute>
					<f:ajax event="click" execute="@form"
						listener="#{additionalTargetDateController.approveAddTrgDateBySup}"></f:ajax>
				</h:commandButton>

				<h:commandButton value="Reject" styleClass="btn btn-primary red">
					<f:attribute name="feedbackID"
						value="#{feedbackDetailsOpenController.myTaskDto.feedbackId}"></f:attribute>
					<f:attribute name="addTrgDateReqDTO"
						value="#{additionalTargetDateController.additionalTrgDateReqDTO}"></f:attribute>
					<f:ajax event="click" execute="@form"
						listener="#{additionalTargetDateController.rejectAddTrgDateBySup}"></f:ajax>
				</h:commandButton>

			</div>

		</rich:popupPanel>
	</h:form>
</h:body>
</html>
