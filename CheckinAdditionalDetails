import om.com.oas.sts.interfaces.StsInterface;
import om.com.oas.sts.to.StsSearchTO;
import om.com.oas.sts.utils.StsUtil;
import om.com.oas.sts.web.forms.StsSearchForm;
import om.com.oas.sts.web.handlers.StsSearchHandler;


/**
 * @author shahin
 *
 */
public class StsSearchAction extends AbstractActionBase {
	private static final Logger LOGGER = LogManager.getLogger(StsSearchAction.class);

	private static String EMPTY_STRING = "";
	private StsSearchHandler stsSearchHandler = null; 
	
	/**
	 * 
	 */
	public StsSearchAction() {
		initHandler();		
		// TODO Auto-generated constructor stub
	}
	
	/* (non-Javadoc)
	 * @see om.com.oas.tar.framework.web.actions.AbstractActionBase#doPerform(org.apache.struts.action.ActionMapping, org.apache.struts.action.ActionForm, javax.servlet.http.HttpServletRequest, javax.servlet.http.HttpServletResponse)
	 */
	public ActionForward doPerform(ActionMapping mapping, ActionForm form,
			HttpServletRequest request, HttpServletResponse response)
								throws IOException, ServletException {
		
		String target = StsWebInterface.STS_SEARCH_VIEW;
				
		try{
			
			Map userPermission=(Map)request.getSession().getAttribute(Constants.USER_PERMISSIONS);
			ModulePermission stsPermission = (ModulePermission)request.getSession().getAttribute(
					StsInterface.STS_PERMISSION);
			UserTO user = (UserTO)request.getSession().getAttribute("USER_INFO");			
			checkAccessPrivileage(form, user, StsInterface.STS_TARGET_REQUEST, stsPermission);
			
			long loggedInStaffNo = user.getStaffNumber();
			
			int updatedCount = 0;
			StsSearchForm stsSearchForm = (StsSearchForm)form;			
			String operation = null;
			StsSearchTO stsSearchTO = new StsSearchTO();
			stsSearchTO.setAccessLevel(getSelectPrivilegesOfUser(userPermission));
			if(stsSearchForm != null && (stsSearchForm.isAccept()|| stsSearchForm.isViewAll() || 
					stsSearchForm.isProcessAll())) {
				stsSearchTO.setAccessLevel(Constants.ORG);
			}
			stsSearchTO.setLoggedInStaffNo(loggedInStaffNo);
			stsSearchTO.setUserId(user.getUserId());
			stsSearchTO.setAccepted(false);
			stsSearchTO.setReportsLoad(false);
			
			if(stsSearchForm != null) {
				operation = stsSearchForm.getOperation();
				populateStsSearchTO(stsSearchTO, stsSearchForm);
			}/* end if */
			LOGGER.info("===== STS SEARCH DEBUG START =====");
			LOGGER.info("Request Parameter op       : " + request.getParameter("op"));
			LOGGER.info("Form Operation            : " + operation);
			LOGGER.info("Travel From Date          : " + stsSearchForm.getTravelFromDate());
			LOGGER.info("Travel To Date            : " + stsSearchForm.getTravelToDate());
			LOGGER.info("DTS Ref                   : " + stsSearchForm.getDtsRef());
			LOGGER.info("STS Ref                   : " + stsSearchForm.getStsRef());
			LOGGER.info("Employee Number           : " + stsSearchForm.getEmpNum());
			LOGGER.info("Department                : " + stsSearchForm.getDeptName());
			
			LOGGER.info("^^^^^^^^^^^^^^^^^^^^^^^^parameter : " + request.getParameter("op"));
			
			// search for accepted list.
			if(request.getParameter("op")!=null && !StsUtil.isEmpty((String)request.getParameter("op"))) {
				if(((String)request.getParameter("op")).trim().equals("acclst")) {		
					stsSearchTO.setAccessLevel(getSelectPrivilegesOfUser(userPermission));
					if(stsSearchForm != null && stsSearchForm.isViewAll()) {
						stsSearchTO.setAccessLevel(Constants.ORG);
					} 
					stsSearchTO.setStatus(StsInterface.STS_REQ_STATUS_ACCEPTED);		
					stsSearchTO.setAction(StsInterface.STS_ACTION_ACCEPTED);
					target = StsWebInterface.STS_ACCPTD_SEARCH_VIEW;
				} else if(((String)request.getParameter("op")).trim().equals("xoinitlst")) {		
					stsSearchTO.setAccessLevel(getSelectPrivilegesOfUser(userPermission));
					if(stsSearchForm != null && stsSearchForm.isViewAll()) {
						stsSearchTO.setAccessLevel(Constants.ORG);
					} 
					stsSearchTO.setStatus(StsInterface.STS_REQ_STATUS_XO_INITIATED);		
					stsSearchTO.setAction(StsInterface.STS_ACTION_XO_INITIATED);
					target = StsWebInterface.STS_XO_INITIATED_SEARCH_VIEW;
				} else if(((String)request.getParameter("op")).trim().equals("rellst")) {		
					if(!StsUtil.isEmpty(stsSearchForm.getAcceptedListStr())){
						stsSearchTO.setAcceptedListStr(stsSearchForm.getAcceptedListStr().substring(
								1,stsSearchForm.getAcceptedListStr().length()));
						stsSearchTO.setTicketId(stsSearchForm.getTicketIdListStr().substring(
								1,stsSearchForm.getTicketIdListStr().length()));
						
						stsSearchTO.setAction(StsInterface.STS_ACTION_RELEASED);
						updatedCount = stsSearchHandler.releaseRequests(stsSearchTO);
					}
					LOGGER.info("UPDATED COUNT : " + updatedCount);
					stsSearchForm.setAcceptedListStr(EMPTY_STRING);
					if(updatedCount > 0) { 
						stsSearchForm.setUserMessage(updatedCount + " request(s) removed from the accepted list.");
					} else {
						stsSearchForm.setUserMessage(EMPTY_STRING);
					}
					stsSearchTO.setStatus(StsInterface.STS_REQ_STATUS_ACCEPTED);		
					stsSearchTO.setAction(StsInterface.STS_ACTION_ACCEPTED);
					target = StsWebInterface.STS_ACCPTD_SEARCH_VIEW;
				} else if(((String)request.getParameter("op")).equals("reqlst")) {	
					if(!StsUtil.isEmpty(stsSearchForm.getAcceptedListStr())){
						stsSearchTO.setAcceptedListStr(stsSearchForm.getAcceptedListStr().substring(
								1,stsSearchForm.getAcceptedListStr().length()));
						stsSearchTO.setTicketId(stsSearchForm.getTicketIdListStr().substring(
								1,stsSearchForm.getTicketIdListStr().length()));
						
						stsSearchTO.setAction(StsInterface.STS_ACTION_ACCEPTED);
						updatedCount = stsSearchHandler.acceptRequests(stsSearchTO);
					}
//					System.out.println("UPDATED COUNT : " + updatedCount);
					stsSearchForm.setAcceptedListStr(EMPTY_STRING);
					if(updatedCount > 0) { 
						stsSearchForm.setUserMessage(updatedCount + " request(s) accepted.");
					} else {
						stsSearchForm.setUserMessage(EMPTY_STRING);
					}
					stsSearchTO.setAction(EMPTY_STRING);
					stsSearchTO.setStatus(StsInterface.STS_REQ_STATUS_REQUEST);
					target = StsWebInterface.STS_PENDING_SEARCH_VIEW;
				} else if(((String)request.getParameter("op")).trim().equals("xolst")) {		
					stsSearchTO.setAccessLevel(getSelectPrivilegesOfUser(userPermission));
					if(stsSearchForm != null && stsSearchForm.isViewAll()) {
						stsSearchTO.setAccessLevel(Constants.ORG);
					} 
					stsSearchTO.setStatus(StsInterface.STS_REQ_STATUS_XO_ISSUED);		
					stsSearchTO.setAction(StsInterface.STS_ACTION_XO_ISSUED);
					target = StsWebInterface.STS_XO_VIEW;
				} else {
					target = StsWebInterface.STS_SEARCH_FAILURE;
					return mapping.findForward(target);
				}
			}
			LOGGER.info("Is operation empty? : " + StsUtil.isEmpty(operation));			
			if(StsUtil.isEmpty(operation)) {
//				System.out.println("calling page load");
				LOGGER.info("Executing LOAD path");
				stsSearchTO.setDepName("-1");
				stsSearchTO = stsSearchHandler.loadSearchParams(stsSearchTO);
				stsSearchForm.setOperation("load");				
			} else {
//				System.out.println("calling search");
				LOGGER.info("Executing SEARCH path");
				LOGGER.info("Search Criteria:");
				LOGGER.info("Access Level      : " + stsSearchTO.getAccessLevel());
				LOGGER.info("Travel From Date  : " + stsSearchTO.getTravelFromDate());
				LOGGER.info("Travel To Date    : " + stsSearchTO.getTravelToDate());
				LOGGER.info("DTS Ref           : " + stsSearchTO.getDtsRef());
				LOGGER.info("STS Ref           : " + stsSearchTO.getStsRef());
				LOGGER.info("Emp No            : " + stsSearchTO.getEmpNum());
				LOGGER.info("Dept Name         : " + stsSearchTO.getDepName());
				LOGGER.info("Status            : " + stsSearchTO.getStatus());
				LOGGER.info("Action            : " + stsSearchTO.getAction());
				stsSearchTO = stsSearchHandler.searchRequests(stsSearchTO);
				if(stsSearchTO.getResultList() != null) {
				    LOGGER.info("Search Result Count : " + stsSearchTO.getResultList().size());
				} else {
				    LOGGER.info("Search Result Count : NULL");
				}

				stsSearchForm.setOperation("search");
			}
			populateStsSearchForm(stsSearchForm, stsSearchTO);
			
			if(StsUtil.isEmpty(operation)) {
				stsSearchForm.setTravelFromDate(StsUtil.dateADD(
						StsUtil.toStringFormat(new Date(), StsUtil.CALENDAR_DATE_FORMAT), 
						StsUtil.CALENDAR_DATE_FORMAT,1,-15));
				stsSearchForm.setTravelToDate(StsUtil.dateADD(
						StsUtil.toStringFormat(new Date(), StsUtil.CALENDAR_DATE_FORMAT), 
						StsUtil.CALENDAR_DATE_FORMAT,1,30));
				LOGGER.info("Default dates are being assigned");
				LOGGER.info("Operation value at this point : " + operation);
			}
						
		} catch (StsException se) {
			se.printStackTrace();
			ActionErrors actionErrors = new ActionErrors();
			ActionError actionError = new ActionError("error.db.sts");
			actionErrors.add("error", actionError);
			saveErrors(request, actionErrors);
			target = StsWebInterface.STS_SEARCH_FAILURE;
		} catch (Exception e) {
			e.printStackTrace();
			ActionErrors actionErrors = new ActionErrors();
			ActionError actionError = new ActionError("error.db.sts");
			actionErrors.add("error", actionError);
			saveErrors(request, actionErrors);
			target = StsWebInterface.STS_SEARCH_FAILURE;
		}
		
		return mapping.findForward(target);
	}/* doPerform */
	
	private int getSelectPrivilegesOfUser(Map userPermission) {
		int accessLevel = 0;
		LOGGER.info("in getSelectPrivilegesOfUser, userPermission:"+userPermission+" target:"+Constants.PRT_STAFF_ACCESS_LEVEL);
		if(userPermission==null)
			return 0;
		Set set = (Set)userPermission.get(Constants.PRT_STAFF_ACCESS_LEVEL);
		if (set != null){
			if(set.contains(Constants.SECT_EMP)) 	accessLevel = Constants.SECT;
			if(set.contains(Constants.DEPT_EMP)) 	accessLevel = Constants.DEPT;
			if(set.contains(Constants.DIV_EMP)) 	accessLevel = Constants.DIV;//SBU/BU Coordinator
			if(set.contains(Constants.ALL_EMP)) 	accessLevel = Constants.ORG;
		}		
		return accessLevel;
	}
	
	/**
	 * populate TO from Form
	 * @param stsSearchTO
	 * @param stsSearchForm
	 * @throws Exception
	 */
	private void populateStsSearchTO(StsSearchTO stsSearchTO, StsSearchForm stsSearchForm) throws Exception {
		stsSearchTO.setTravelFromDate(StsUtil.CalendatDateToAdvancedDate(stsSearchForm.getTravelFromDate()));
		stsSearchTO.setTravelToDate(StsUtil.CalendatDateToAdvancedDate(stsSearchForm.getTravelToDate()));
		stsSearchTO.setDtsRef(stsSearchForm.getDtsRef());
		stsSearchTO.setStsRef(stsSearchForm.getStsRef());
		stsSearchTO.setEmpNum(stsSearchForm.getEmpNum());		
		stsSearchTO.setStatus(stsSearchForm.getStatus());		
		stsSearchTO.setDepName(stsSearchForm.getDeptName());
	}/* populateStsSearchTO */
	
	/**
	 * populate Form from TO
	 * @param stsSearchForm
	 * @param stsSearchTO
	 * @throws Exception
	 */
	private void populateStsSearchForm(StsSearchForm stsSearchForm, StsSearchTO stsSearchTO) throws Exception {
		stsSearchForm.setTravelFromDate(StsUtil.AdvancedDateTOCalendatDate(stsSearchTO.getTravelFromDate()));
		stsSearchForm.setTravelToDate(StsUtil.AdvancedDateTOCalendatDate(stsSearchTO.getTravelToDate()));
		stsSearchForm.setDtsRef(stsSearchTO.getDtsRef());
		stsSearchForm.setStsRef(stsSearchTO.getStsRef());
		stsSearchForm.setEmpNum(stsSearchTO.getEmpNum());
		stsSearchForm.setStatus(stsSearchTO.getStatus());
		stsSearchForm.setStatusList(stsSearchTO.getStatusList());
		stsSearchForm.setDeptList(stsSearchTO.getDepList());
		stsSearchForm.setDeptName(stsSearchTO.getDepName());
		stsSearchForm.setResultList(stsSearchTO.getResultList());
	}/* populateStsSearchTO */
    /**
     * method to initialize the StsSearchHandler instance
     */
    private void initHandler() {
        try {
            if (this.stsSearchHandler == null) {
                this.stsSearchHandler = (StsSearchHandler) 
                    Class.forName(StsInterface.STS_SEARCH_HANDLER).newInstance();                    
            }/* end if */
        } catch (Exception e) {
            e.printStackTrace();
        }/* end try */ 
    }/* initHandler */
}

