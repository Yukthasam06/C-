function attachByteLimit(field, maxBytes, removeNewLine) {
	 
    //Normal typing / deletion
    field.addEventListener("beforeinput", function (event) {
    	
        //Only block insertion, Delete / Backspace always be allowed
        if (event.inputType !== "insertText" &amp;&amp;
            event.inputType !== "insertCompositionText") {
            return;
        }
 
        var start = field.selectionStart;
        var end = field.selectionEnd;
        var insertedText = event.data || "";
 
        //Remove newline characters
        if (removeNewLine) {
            insertedText = insertedText.replace(/[\r\n]/g, "");
        }
 
        var newValue = field.value.substring(0, start) + insertedText + field.value.substring(end);
        
        //If the resulting value exceeds the limit, prevent the character from being inserted.
        if (getByteLength(newValue) > maxBytes) {
            event.preventDefault();
        }
 
    });
 
    //Paste
    field.addEventListener("paste", function (event) {
 
        event.preventDefault();
        var pastedText = event.clipboardData.getData("text");
 
        if (removeNewLine) {
            pastedText = pastedText.replace(/[\r\n]/g, "");
        }
        var start = field.selectionStart;
        var end = field.selectionEnd;
        var before = field.value.substring(0, start);
        var after = field.value.substring(end);
 
        // Retain as much of the pasted content as possible while ensuring the total input does not exceed the configured byte limit.
        var availableBytes = maxBytes - getByteLength(before + after);
 
        if (availableBytes &lt; 0) {
            availableBytes = 0;
        }
        var trimmedPaste = trimToByteLength(pastedText, availableBytes);
        var newValue = before + trimmedPaste + after;
 
        field.value = newValue;
 
        //Put cursor immediately after the pasted text.
        var newCursorPosition = before.length + trimmedPaste.length;
 
        setTimeout(function () {
            field.setSelectionRange(newCursorPosition, newCursorPosition);
        }, 0);
    });
 
    // Handles browser/programmatic input and guarantees that the field never exceeds the limit.
    field.addEventListener("input", function () {
        validateByteLength(field, maxBytes, removeNewLine);
    });
}
 
function validateByteLength(field, maxBytes, removeNewLine) {
 
    var value = field.value;
    var cursorStart = field.selectionStart;
    var cursorEnd = field.selectionEnd;
 
    // Remove newline characters
    if (removeNewLine) {
        var oldBeforeCursor = value.substring(0, cursorStart);
        value = value.replace(/[\r\n]/g, "");
 
        cursorStart = oldBeforeCursor.replace(/[\r\n]/g, "").length;
        cursorEnd = cursorStart;
    } 
    if (getByteLength(value) &lt;= maxBytes) {
 
        if (field.value !== value) {
            field.value = value;
        }
        setCursorPosition(field, cursorStart, cursorEnd);
        return;
    }
 
    // Fallback protection.
    value = trimToByteLength(value, maxBytes);
    field.value = value;
 
    // Ensure cursor doesn't exceed the new value.
    cursorStart = Math.min(cursorStart, value.length);
    cursorEnd = Math.min(cursorEnd, value.length);
 
    setCursorPosition(field, cursorStart, cursorEnd);
}
 
function trimToByteLength(value, maxBytes) {
 
    var result = "";
    var chars = Array.from(value);
 
    for (var i = 0; i &lt; chars.length; i++) {
 
        var candidate = result + chars[i];
 
        if (getByteLength(candidate) > maxBytes) {
            break;
        }
        result = candidate;
    }
    return result;
}
 
function getByteLength(value) { 
    return new TextEncoder().encode(value).length;
}
 
function setCursorPosition(field, start, end) {
 
    setTimeout(function () {
        field.setSelectionRange(start, end);
    }, 0);
}
 
function dataTableSelectOneRadio(radio) {
    var radioId = radio.name.substring(radio.name.lastIndexOf(':'));
	
    for (var i = 0; i &lt; radio.form.elements.length; i++) {
        var element = radio.form.elements[i];

        if (element.name.substring(element.name.lastIndexOf(':')) == radioId) {
            element.checked = false;
        }
    }

    radio.checked = true;
}
</script>


