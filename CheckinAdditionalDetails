public class OverDueTransferAction extends AbstractAction {
	
	static Properties prop = new Properties();
	
    protected ActionForward myExecute(ActionMapping mapping, ActionForm form, HttpServletRequest request, HttpServletResponse response) throws Exception {
        DutyTravelDelegate dutyTravelDelegate=new DutyTravelDelegate();
        OverdueTranferForm odsForm= (OverdueTranferForm) form;
        OverDueSearchTO odsTo = new OverDueSearchTO();

        String operation = odsForm.getOperation();
        System.out.println( " ****OverDueTransferAction.getActionString() : "+operation);
        
        String BIRT_HOME_STR = (String) request.getSession().getAttribute("BIRT_HOME_STR");
        
        System.out.println(BIRT_HOME_STR);
        odsTo.setBirtHomeString(BIRT_HOME_STR);

        List<String> failedIds = new ArrayList<>();
        String message = "NA";
        
        if (operation.equals("SEND_MAIL")){
            Collection overDueTransfers4Percom=(Collection) request.getAttribute("overDueTransfers4Percom");
            System.out.println("SEND overDues.size()>>>>>>>>>>>>>>>>: "+overDueTransfers4Percom.size());
            System.out.println("SEND overDues List>>>>>>>>>>>>>>>>: "+overDueTransfers4Percom.toString());

            System.out.println("Mailing ........................ >");
            System.out.println("STAFF YN>>>>>>>>>>>>>>>>>>>>: "+odsForm.getCcAllAuthYn());
            System.out.println("HOD YN>>>>>>>>>>>>>>>>>>>>: "+odsForm.getCcApproverYn());
            System.out.println("CC Mail ID>>>>>>>>>>>>>>>>>>>>: "+odsForm.getCcMailId());
            System.out.println("FROM search page **************");
            System.out.println("odsForm.getDepName---------->"+odsForm.getDepName());
            System.out.println("odsForm.getDueDays---------->"+odsForm.getDueDays());
            System.out.println("odsForm.getTravelFromDate---------->"+odsForm.getTravelFromDate());
            System.out.println("odsForm.getTravelToDate---------->"+odsForm.getTravelToDate());
            populateODSearchTO(odsForm,odsTo);
            IReportEngine reportEngine = (IReportEngine) request.getSession().getAttribute("BIRTEngine");
            
            /*SR 39706 Email Automation and enhancement in Overdue*/
            Collection mailsToList = (Collection)dutyTravelDelegate.getMailDetails(overDueTransfers4Percom,odsTo);
            odsTo.setReportMailTOListEmp(mailsToList);
            odsTo.setMailToHod("0");
            //Send to individual staff    
            dutyTravelDelegate.sendReportMail(reportEngine,odsTo);
            odsForm.setActionString("SEND");

        }else{
            if (operation.equals("TRANSFER")){
                System.out.println("in overdue Transfer.");
        		UserTO user = (UserTO)request.getSession().getAttribute("USER_INFO");
                String userId = user.getUserId();
                Collection overDueTransfers4Percom=(Collection) request.getAttribute("overDueTransfers4Percom");
                System.out.println("TRANSFER overDues1.size()>>>>>>>>>>>>>>>>: "+overDueTransfers4Percom.size());
                System.out.println("Calling PROCEDURE..................:::::::>>>>");
                failedIds = dutyTravelDelegate.callOverDueProcedure(overDueTransfers4Percom, userId);
                if (failedIds == null) {
                	message = "Failure";
                } else if (failedIds.isEmpty()) {
                    message = "Success";
                } else {
                	message = "InActiveStaff";
                }

            }else {
                if (operation.equals("TRAINING")){
                    odsTo.setTrainingOverdues(true);   
                    odsTo.setTrainingHeadMailId(dutyTravelDelegate.getTrainingHeadMail());
                    IReportEngine reportEngine = (IReportEngine) request.getSession().getAttribute("BIRTEngine");
                    dutyTravelDelegate.sendReportMail(reportEngine,odsTo);
                    odsForm.setActionString("SEND");          
                }
            }
        }
           
        populateODSearchTO(odsForm,odsTo);
        odsForm.setOperation("result");
        String nonWYPayroll = null;
        if(odsForm.isNonWYPayroll()) {
        InputStream input = null;
		String envNonWYPayroll = null;
		try {
		input = getClass().getClassLoader().getResourceAsStream("dts.properties");
        prop.load(input);
        nonWYPayroll = prop.getProperty("nonWY.payroll").trim();
        envNonWYPayroll = System.getenv("NONWY_PAYROLLID");
        if (nonWYPayroll.contains("${NONWY_PAYROLLID}")) {
        	nonWYPayroll = nonWYPayroll.replace("${NONWY_PAYROLLID}", envNonWYPayroll);
        }
		} catch(Exception e) {
			e.printStackTrace();
		}
        }
        Collection dutyTravels = dutyTravelDelegate.getOverDueRequests(odsTo,odsForm,nonWYPayroll);
        
        List<DutyTravelSummary> overdueList = new ArrayList<>(dutyTravels);
        
        int pageSize = 15;
		
		if(overdueList.size() > pageSize) {
			
			int currentPage = 1;
		    String currentPageParam = request.getParameter("currentPage");
		    if (currentPageParam != null && !currentPageParam.isEmpty()) {
		        currentPage = Integer.parseInt(currentPageParam);
		    }
		    int startIndex = (currentPage - 1) * pageSize;
		    int endIndex = Math.min(startIndex + pageSize, overdueList.size());

			List<DutyTravelSummary> currentPageDutyTravels = overdueList.subList(startIndex, endIndex);			
			request.setAttribute("DutyTravelSummaries", currentPageDutyTravels);
			request.setAttribute("currentPage", currentPage);
			request.setAttribute("pageSize", pageSize);
			request.setAttribute("startIndex", startIndex+1);
			request.setAttribute("totalRecords", overdueList.size()); // Total number of records in the entire list
			request.setAttribute("requiredPaging", true);
			
		}else {
			request.setAttribute("DutyTravelSummaries", dutyTravels);
			request.setAttribute("requiredPaging", false);
		}
        
		odsForm.setisNonWYPayroll(false);
		odsForm.setisActiveStaff(false);
		request.setAttribute("TransferMessage", message);
		request.setAttribute("InActiveStaffID", failedIds);
		
        return mapping.findForward("SUCCESS");

    }

