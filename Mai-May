function isValExist(myVar){
	var result= true;
	if (!myVar){
		result = false;
	}
	if (undefined == myVar){
		result = false;
	}
	if (myVar == null) {
		result = false;
	}
	if (myVar == ""){
		result = false;
	}	
	return result;
}

	
