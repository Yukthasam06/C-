            <xml-property name="queryText"><![CDATA[SELECT   grp_code, sub_grp_code, travel_type_name, SUM (count1), SUM (da1),
         SUM (ha1), SUM (oa1), SUM (count2), SUM (da2), SUM (ha2), SUM (oa2)
    FROM (SELECT   grp_code, sub_grp_code, travel_type_name,
                   COUNT (travel_type_name) count1, SUM (da) da1, SUM (ha)
                                                                          ha1,
                   SUM (oa) oa1, NULL count2, NULL da2, NULL ha2, NULL oa2
              FROM wynetadm.dts_settled_view
             WHERE 1 = 1
               AND TRUNC (performed_end_time) BETWEEN ?
                                                  AND ?
          GROUP BY grp_code, sub_grp_code, travel_type_name
          UNION ALL
          SELECT   grp_code, sub_grp_code, travel_type_name, NULL count1,
                   NULL da1, NULL ha1, NULL oa1,
                   COUNT (travel_type_name) count2, SUM (da) da2, SUM (ha)
                                                                          ha2,
                   SUM (oa) oa2
              FROM wynetadm.dts_settled_view
             WHERE 1 = 1
               AND TRUNC (performed_end_time) BETWEEN ADD_MONTHS
                                                               (?,
                                                                -12
                                                               )
                                                  AND ADD_MONTHS
                                                               (?,
                                                                -12
                                                               )
          GROUP BY grp_code, sub_grp_code, travel_type_name)
GROUP BY grp_code, sub_grp_code, travel_type_name
ORDER BY grp_code, sub_grp_code]]></xml-property>
