public Set<String> getFromStations() {
		Session session=null;
		List<FlightRouteInfo> fromStationsList=null;
		Set<String> stationInfo =null;
		try {
			session = sessionFactory.openSession();
			Query query=session.createQuery("from FlightRouteInfo");
			fromStationsList = query.list();
			if(null!=fromStationsList && fromStationsList.size()>0){
				stationInfo=new HashSet<String>();
				for (FlightRouteInfo flightRouteVo : fromStationsList) {
				//	LOGGER.info("CONNECTION DETAILS ==>>>"+flightRouteVo.getFlightConnectionInfo().toString());
				//	LOGGER.info("CONNECTION LENGTH ==>>>"+flightRouteVo.getFlightConnectionInfo().size());
					if(flightRouteVo.getFlightConnectionInfo() != null && flightRouteVo.getFlightConnectionInfo().size() >0){
						stationInfo.add(flightRouteVo.getFromStation());
					}
				}
			}
		} catch (Exception e) {
			LOGGER.error("EXCEPTION :-"+ e.getMessage(),e);
		}finally {
			if (session != null) {
				session.close();
			}
		}
		return stationInfo;
	}

